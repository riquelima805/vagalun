PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-key-change-in-production

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Solana
SOLANA_NETWORK=devnet
SOLANA_WALLET=your_solana_wallet_address_here
SOLANA_RPC=https://api.devnet.solana.com

# Client
CLIENT_URL=http://localhost:5173

# Efi/Efí (integração real)
EFI_CLIENT_ID=your_efi_client_id
EFI_CLIENT_SECRET=your_efi_secret

# Bank API (integração real)
BANK_API_KEY=your_bank_api_key


GATEWAY_URL=http://localhost:8788
GATEWAY_ADMIN_TOKEN=seu_token_2
GATEWAY_RELAY_URL=ws://localhost:8787
GATEWAY_RELAY_NODE_ID=node-509457,outro-celular-quando-tiver
GATEWAY_BASE_DOMAIN=seudominio.com

# Streaming P2P (vídeo/áudio direto do celular pro navegador, sem passar pela
# banda da VPS — ver sever/gateway/p2pPlayerScript.js). Essa env fica no
# processo do GATEWAY (sever/gateway/gateway.js), não no hosting — só
# documentando aqui junto pra não se perder:
#   GATEWAY_SIGNALING_PUBLIC_URL=wss://signal.seudominio.com
# Precisa ser a URL do signaling (sever/server.js) alcançável PELO NAVEGADOR
# do visitante (wss:// público, atrás de proxy/TLS se for produção) — não a
# URL interna que o hosting usa em GATEWAY_RELAY_URL acima.