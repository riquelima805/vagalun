{
  "name": "hosting-platform",
  "version": "1.0.0",
  "description": "Platform de hospedagem de sites estáticos + streaming leve com Solana/Stripe",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:client": "cd client && npm run build",
    "dev:full": "concurrently \"npm run dev\" \"cd client && npm run dev\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "multer": "^1.4.5-lts.1",
    "unzipper": "^0.10.11",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.0",
    "jsonwebtoken": "^9.0.0",
    "bcrypt": "^5.1.0",
    "sharp": "^0.33.0",
    "@solana/web3.js": "^1.10.0"
  }
}