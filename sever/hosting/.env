PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-key-change-in-production

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Solana
SOLANA_NETWORK=devnet
SOLANA_WALLET=your_solana_wallet_address_here
SOLANA_RPC=https://api.devnet.solana.com

# Client
CLIENT_URL=http://localhost:5173

# Verificação de e-mail no cadastro
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_smtp_password_or_api_key
SMTP_FROM=no-reply@seudominio.com


EFI_CLIENT_ID=your_efi_client_id
EFI_CLIENT_SECRET=your_efi_secret


BANK_API_KEY=your_bank_api_key


GATEWAY_URL=http://localhost:8788
GATEWAY_ADMIN_TOKEN=seu_token_2
GATEWAY_RELAY_URL=ws://localhost:8787
GATEWAY_RELAY_NODE_ID=node-509457,outro-celular-quando-tiver
GATEWAY_BASE_DOMAIN=seudominio.com

